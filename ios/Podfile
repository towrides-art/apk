ENV['RCT_NEW_ARCH_ENABLED'] = '0'
ENV['RCT_SKIP_CODEGEN'] = '1'

node_binary = ENV['NODE_BINARY']
if node_binary.nil? || node_binary.empty?
  node_binary = Pod::Executable.execute_command('which', ['node']).strip
end
ENV['NODE_BINARY'] = node_binary

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

use_frameworks! :linkage => :static

# ── Monkey-patch: intercept pod() calls to block Firebase/RNFB ──
BLOCKED_POD_PREFIXES = %w[
  RNFBApp RNFBAuth RNFBMessaging
  Firebase FirebaseCore FirebaseAuth FirebaseMessaging
  FirebaseCoreInternal FirebaseInstallations FirebaseCoreExtension
  FirebaseAppCheckInterop FirebaseAuthInterop
  GoogleUtilities GoogleDataTransport
  GTMSessionFetcher FBLPromises PromisesObjC
  nanopb RecaptchaInterop NotifeeCore RNNotifee
]

module BlockFirebasePods
  def pod(name, *args, **kwargs, &block)
    if BLOCKED_POD_PREFIXES.any? { |prefix| name.start_with?(prefix) }
      puts "[PODFILE-BLOCK] Skipping pod: #{name}"
      return
    end
    super(name, *args, **kwargs, &block)
  end
end

class Podfile
  class TargetDefinition
    prepend BlockFirebasePods
  end
end
# ── End monkey-patch ──

target 'TowRides' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    :fabric_enabled => false,
    :new_arch_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :flipper_configuration => FlipperConfiguration.disabled
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # ── NUCLEAR: Remove ALL Firebase/RNFB targets from Pods.xcodeproj ──
    firebase_pattern = /\A(RNFB|Firebase|GoogleUtilities|GoogleDataTransport|GTMSessionFetcher|FBLPromises|PromisesObjC|nanopb|RecaptchaInterop|Notifee)/i
    removed_targets = []
    installer.pods_project.targets.to_a.each do |target|
      if target.name =~ firebase_pattern
        removed_targets << target.name
        target.remove_from_project
      end
    end
    unless removed_targets.empty?
      puts "[PODFILE-NUCLEAR] Removed #{removed_targets.length} Firebase/RNFB targets: #{removed_targets.join(', ')}"
    end

    # ── Remove [CP-User] [RNFB] Core Configuration from main app ──
    main_project_path = File.join(__dir__, 'TowRides.xcodeproj')
    if File.exist?(main_project_path)
      require 'xcodeproj'
      app_proj = Xcodeproj::Project.open(main_project_path)
      app_proj.targets.each do |t|
        t.build_phases.to_a.each do |bp|
          if bp.respond_to?(:name) && bp.name.to_s =~ /RNFB|Firebase/i
            puts "[PODFILE-NUCLEAR] Removing build phase: #{bp.name}"
            bp.remove_from_project
          end
        end
      end
      app_proj.save
    end

    # ── Delete Firebase/RNFB pod source folders ──
    pods_dir = installer.sandbox.root
    %w[RNFBApp RNFBAuth RNFBMessaging Firebase FirebaseCore FirebaseAuth
       FirebaseMessaging FirebaseCoreInternal FirebaseInstallations
       FirebaseCoreExtension FirebaseAppCheckInterop FirebaseAuthInterop
       GoogleUtilities GoogleDataTransport GTMSessionFetcher FBLPromises
       PromisesObjC nanopb RecaptchaInterop].each do |pod_name|
      pod_path = pods_dir + pod_name
      if pod_path.exist?
        FileUtils.rm_rf(pod_path)
        puts "[PODFILE-NUCLEAR] Deleted pod folder: #{pod_name}"
      end
      tsf = pods_dir + 'Target Support Files' + pod_name
      FileUtils.rm_rf(tsf) if tsf.exist?
    end
    # Delete RNFB/Firebase headers
    ['Public', 'Private'].each do |vis|
      headers_dir = pods_dir + 'Headers' + vis
      next unless headers_dir.exist?
      headers_dir.children.each do |child|
        if child.basename.to_s =~ firebase_pattern
          FileUtils.rm_rf(child)
          puts "[PODFILE-NUCLEAR] Deleted headers: #{child.basename}"
        end
      end
    end

    installer.pods_project.save

    # ── Standard build settings ──
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        cfg.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        cfg.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        cfg.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        cfg.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        cfg.build_settings['ENABLE_BITCODE'] = 'NO'
        cfg.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        cfg.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        cfg.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        cfg.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
        cfg.build_settings['SWIFT_VERSION'] = '5.0'
        cfg.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
        cfg.build_settings['OTHER_CFLAGS'] = ['$(inherited)', '-w', '-Wno-error']
        cfg.build_settings['OTHER_SWIFT_FLAGS'] = ['$(inherited)', '-suppress-warnings']
        cfg.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        defs = Array(cfg.build_settings['GCC_PREPROCESSOR_DEFINITIONS'])
        defs.reject! { |d| d.to_s.include?('RCT_NEW_ARCH_ENABLED') }
        cfg.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs.empty? ? ['$(inherited)'] : defs
      end
    end
  end
end
