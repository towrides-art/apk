ENV['RCT_NEW_ARCH_ENABLED'] = '0'

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'

use_modular_headers!

prepare_react_native_project!

target 'TowRides' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    :fabric_enabled => false,
    :new_arch_enabled => false,
    :production => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    installer.pods_project.targets.each do |target|
      # Remove all Fabric-related targets to avoid hash_compile errors
      if target.name.include?('React-Fabric') ||
         target.name.include?('React-graphics') ||
         target.name.include?('React-renderer') ||
         target.name.include?('React-ImageManager') ||
         target.name.include?('React-FabricImage') ||
         target.name.include?('React-RCTFabric')
        target.remove_from_project
      end

      # Remove react-native-safe-area-context due to Xcode 16 incompatibility
      if target.name.include?('react-native-safe-area-context')
        target.remove_from_project
      end

      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++17'
        config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'RCT_NEW_ARCH_ENABLED=0'
        config.build_settings['SWIFT_VERSION'] = '5.0'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
        config.build_settings['ENABLE_BITCODE'] = 'NO'

        # Add C++ flags for problematic targets
        if target.name.include?('react-native-simple-toast')
          config.build_settings['OTHER_CFLAGS'] ||= ['$(inherited)']
          config.build_settings['OTHER_CFLAGS'] << '-fno-exceptions'
          config.build_settings['OTHER_CFLAGS'] << '-fno-rtti'
        end

        # Fix RNSVG compilation with Xcode 16
        if target.name == 'RNSVG'
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'RCT_ENABLE_NEW_ARCH=0'
          config.build_settings['OTHER_CFLAGS'] ||= ['$(inherited)']
          config.build_settings['OTHER_CFLAGS'] += ['-Wno-error=non-virtual-dtor', '-Wno-error=deprecated']
          config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        end
      end
    end
  end
end
