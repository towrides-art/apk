ENV['RCT_NEW_ARCH_ENABLED'] = '0'
ENV['RCT_SKIP_CODEGEN'] = '1'

node_binary = ENV['NODE_BINARY']
if node_binary.nil? || node_binary.empty?
  node_binary = Pod::Executable.execute_command('which', ['node']).strip
end
ENV['NODE_BINARY'] = node_binary

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

BLOCKED_PODS = %w[
  RNFBApp RNFBAuth RNFBMessaging RNFBStorage RNFBDatabase RNFBFirestore
  RNFBAnalytics RNFBCrashlytics RNFBDynamicLinks RNFBFunctions RNFBInAppMessaging
  RNFBPerf RNFBRemoteConfig RNFBMLKit
  Firebase FirebaseCore FirebaseAuth FirebaseMessaging FirebaseAnalytics
  FirebaseCrashlytics FirebaseDatabase FirebaseFirestore FirebaseStorage
  FirebaseInstallations FirebaseRemoteConfig GoogleDataTransport
  GoogleUtilities nanopb PromisesObjC AbseilCpp gRPC-C++ gRPC-Core
].freeze

pre_install do |installer|
  installer.pod_targets.reject! do |pod|
    BLOCKED_PODS.any? { |b| pod.name.start_with?(b) }
  end
end

platform :ios, '15.1'
prepare_react_native_project!

use_frameworks! :linkage => :static

target 'TowRides' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    :fabric_enabled => false,
    :new_arch_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :flipper_configuration => FlipperConfiguration.disabled
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Remove any RNFB build phases injected by CocoaPods
    installer.pods_project.targets.each do |t|
      t.build_phases.reject! do |phase|
        n = phase.respond_to?(:name) ? phase.name.to_s : ''
        n.include?('RNFB') || n.include?('Firebase')
      end
    end

    # Remove RNFB build phases from main app project too
    main_proj_path = File.join(File.dirname(__FILE__), 'TowRides.xcodeproj')
    if File.exist?(main_proj_path)
      require 'xcodeproj'
      main_proj = Xcodeproj::Project.open(main_proj_path)
      main_proj.targets.each do |t|
        t.build_phases.reject! do |phase|
          n = phase.respond_to?(:name) ? phase.name.to_s : ''
          removed = n.include?('RNFB') || n.include?('Firebase')
          puts "[Podfile] Removing build phase: #{n}" if removed
          removed
        end
      end
      main_proj.save
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        cfg.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        cfg.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        cfg.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        cfg.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        cfg.build_settings['ENABLE_BITCODE'] = 'NO'
        cfg.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
        cfg.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        cfg.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        cfg.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
        cfg.build_settings['SWIFT_VERSION'] = '5.0'
        cfg.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
        cfg.build_settings['OTHER_CFLAGS'] = ['$(inherited)', '-w', '-Wno-error']
        cfg.build_settings['OTHER_SWIFT_FLAGS'] = ['$(inherited)', '-suppress-warnings']
        cfg.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        defs = Array(cfg.build_settings['GCC_PREPROCESSOR_DEFINITIONS'])
        defs.reject! { |d| d.to_s.include?('RCT_NEW_ARCH_ENABLED') }
        cfg.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs.empty? ? ['$(inherited)'] : defs
      end
    end
  end
end
